{
  "name": "@geoblocks/cesium-post-process",
  "version": "0.6.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/geoblocks/cesium-helpers/",
    "directory": "packages/cesium-post-process"
  },
  "main": "dist/cesium-post-process.js",
  "module": "dist/cesium-post-process.js",
  "types": "dist/cesium-post-process.d.ts",
  "exports": {
    ".": {
      "source": "./src/cesium-post-process.js",
      "types": "./dist/cesium-post-process.d.ts",
      "default": "./dist/cesium-post-process.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.js"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cesium/core": ">=0.1.0",
    "@cesium/engine": ">=10"
  }
}
