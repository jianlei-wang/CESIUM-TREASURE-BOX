{
  "name": "cesium-toolbox-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-cases.mjs && node scripts/gen-case-catalog.mjs",
    "test:studio": "node scripts/studio-selfcheck.mjs",
    "test:output": "playwright test",
    "test:output:update": "playwright test --update-snapshots",
    "case-list": "node scripts/gen-case-list.mjs",
    "sync-articles": "node scripts/sync-articles.mjs",
    "predev": "npm run sync && node scripts/copy-rapier.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 0.0.0.0",
    "server": "node server/index.mjs",
    "test:views": "node --test server/test/*.test.mjs",
    "test:worker": "node --test worker/test/*.test.mjs",
    "prebuild": "npm run sync && node scripts/copy-rapier.mjs",
    "build": "vue-tsc -b && node --max-old-space-size=3072 node_modules/vite/bin/vite.js build && node scripts/gen-runtime-config.mjs && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src/cases/presentation-studio-lib src/App.vue src/main.ts src/runtime-config.ts src/lib/case-views.ts server worker scripts/dev.mjs scripts/gen-case-catalog.mjs scripts/gen-runtime-config.mjs scripts/studio-selfcheck.mjs scripts/security-audit.mjs scripts/check-licenses.mjs scripts/check-lockfile.mjs scripts/check-bundle.mjs tests playwright.config.mjs playwright.soak.config.mjs eslint.config.mjs --quiet",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"scripts/{studio-selfcheck,security-audit,check-licenses,check-lockfile,check-bundle}.mjs\" \"server/**/*.mjs\" \"worker/**/*.mjs\" \"scripts/dev.mjs\" \"scripts/gen-case-catalog.mjs\" \"scripts/gen-runtime-config.mjs\" \"render.yaml\" \"public/admin/*.{js,css}\" \"tests/**/*.{mjs,html}\" \"playwright.config.mjs\" \"playwright.soak.config.mjs\" \"eslint.config.mjs\" \"src/cases/presentation-studio-lib/core/{schema,project-package,tracks,easing,export-pipeline,export-profile,data-sources,layer-registry,scene-template,diagnostics,sdk}.ts\"",
    "format:check": "prettier --check \"scripts/{studio-selfcheck,security-audit,check-licenses,check-lockfile,check-bundle}.mjs\" \"server/**/*.mjs\" \"worker/**/*.mjs\" \"scripts/dev.mjs\" \"scripts/gen-case-catalog.mjs\" \"scripts/gen-runtime-config.mjs\" \"render.yaml\" \"public/admin/*.{js,css}\" \"tests/**/*.{mjs,html}\" \"playwright.config.mjs\" \"playwright.soak.config.mjs\" \"eslint.config.mjs\" \"src/cases/presentation-studio-lib/core/{schema,project-package,tracks,easing,export-pipeline,export-profile,data-sources,layer-registry,scene-template,diagnostics,sdk}.ts\"",
    "audit": "node scripts/security-audit.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "quality": "npm run lint && npm run format:check && npm run audit && npm run licenses && npm run lockfile:check && npm run test:views && npm run test:worker",
    "bundle:check": "node scripts/check-bundle.mjs",
    "test:soak": "playwright test --config=playwright.soak.config.mjs",
    "test:cases": "tsx --test src/cases/cesium-three-lib/simulations/*.test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@petamoriken/float16": "^3.9.3",
    "@turf/center": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/invariant": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/meta": "^7.4.0",
    "@types/three": "^0.185.4",
    "a5-js": "^0.10.1",
    "cesium": "^1.144.0",
    "d3": "^7.9.0",
    "d3-geo": "^2.0.2",
    "dggal": "^0.0.6",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.8",
    "geotiff": "^2.1.3",
    "h3-js": "^4.5.0",
    "html2canvas": "^1.4.1",
    "jsfive": "^0.4.2",
    "jspdf": "^4.2.1",
    "jsts": "^2.7.1",
    "jszip": "^3.10.1",
    "lit": "^3.3.3",
    "mp4-muxer": "^5.2.2",
    "ngeohash": "^0.6.4",
    "open-location-code-typescript": "^1.5.0",
    "proj4": "^2.22.0",
    "s2js": "^1.44.0",
    "shp-write": "^0.3.2",
    "shpjs": "^6.2.0",
    "three": "^0.185.1",
    "three.quarks": "^0.17.1",
    "vue": "^3.5.13",
    "webdggrid": "^1.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/ngeohash": "^0.6.8",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0",
    "vite-plugin-cesium": "^1.2.23",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.5"
  }
}
